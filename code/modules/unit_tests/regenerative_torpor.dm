/// Torpor heals over time, enforces unconsciousness, and cleans up when its mutation is removed.
/datum/unit_test/regenerative_torpor/Run()
	var/mob/living/carbon/human/patient = allocate(/mob/living/carbon/human/consistent)
	patient.nutrition = NUTRITION_LEVEL_FED
	patient.dna.add_mutation(/datum/mutation/regenerative_torpor, MUTATION_SOURCE_ACTIVATED)
	var/datum/action/cooldown/regenerative_torpor/action = locate() in patient.actions
	TEST_ASSERT_NOTNULL(action, "Genetics must grant the torpor ability.")
	patient.adjust_brute_loss(20)
	patient.adjust_fire_loss(20)
	patient.adjust_tox_loss(10)
	var/obj/item/organ/liver = patient.get_organ_slot(ORGAN_SLOT_LIVER)
	liver.set_organ_damage(10)
	TEST_ASSERT(action.Activate(patient), "A fed, conscious patient should enter torpor.")
	var/datum/status_effect/regenerative_torpor/torpor = patient.has_status_effect(/datum/status_effect/regenerative_torpor)
	TEST_ASSERT_NOTNULL(torpor, "Activation must apply torpor.")
	TEST_ASSERT(HAS_TRAIT(patient, TRAIT_KNOCKEDOUT), "Torpor must render the patient helpless.")
	TEST_ASSERT_EQUAL(patient.get_brute_loss(), 20, "Activation must not heal instantly.")
	TEST_ASSERT(action.next_use_time > world.time, "Activation must start the cooldown.")
	torpor.tick(2)
	TEST_ASSERT_EQUAL(patient.get_brute_loss(), 16, "Healing must scale with elapsed time.")
	TEST_ASSERT_EQUAL(patient.get_fire_loss(), 16, "Torpor must heal burns.")
	TEST_ASSERT_EQUAL(patient.get_tox_loss(), 8, "Torpor must heal toxin damage.")
	TEST_ASSERT_EQUAL(liver.damage, 9, "Torpor must gradually repair organic organs.")
	TEST_ASSERT(patient.nutrition < NUTRITION_LEVEL_FED, "Healing must consume nutrition.")
	patient.dna.remove_mutation(/datum/mutation/regenerative_torpor, MUTATION_SOURCE_ACTIVATED)
	TEST_ASSERT(!patient.has_status_effect(/datum/status_effect/regenerative_torpor), "Removing the mutation must stop torpor.")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_KNOCKEDOUT), "Removing torpor must release its unconsciousness trait.")
	patient.nutrition = NUTRITION_LEVEL_STARVING
	torpor = patient.apply_status_effect(/datum/status_effect/regenerative_torpor)
	torpor.tick(1)
	TEST_ASSERT(QDELETED(torpor), "Starvation must end torpor.")
	TEST_ASSERT(!HAS_TRAIT(patient, TRAIT_KNOCKEDOUT), "Starvation must not leave the patient trapped unconscious.")
