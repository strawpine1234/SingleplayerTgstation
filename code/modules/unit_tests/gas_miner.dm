/// Configurable boards build the selected miner and retain their setting on disassembly.
/datum/unit_test/gas_miner/Run()
	var/datum/design/board/gas_miner/design = allocate(/datum/design/board/gas_miner)
	TEST_ASSERT_EQUAL(design.departmental_flags, ALL, "Every department must be able to print the board.")
	TEST_ASSERT(design.build_type & IMPRINTER, "Standard imprinters must support this board.")
	TEST_ASSERT(design.build_type & AWAY_IMPRINTER, "Away imprinters must support this board.")
	var/turf/open/location = run_loc_floor_bottom_left
	var/datum/gas_mixture/empty_air = allocate(/datum/gas_mixture)
	empty_air.temperature = T20C
	var/obj/item/circuitboard/machine/gas_miner/options = allocate(/obj/item/circuitboard/machine/gas_miner)
	TEST_ASSERT(!options.select_gas("Zauker"), "Unsupported exotic gases must not be selectable.")
	for(var/selection in options.gas_options)
		var/obj/item/circuitboard/machine/gas_miner/board = allocate(/obj/item/circuitboard/machine/gas_miner)
		TEST_ASSERT(board.select_gas(selection), "Every listed gas must be selectable.")
		var/obj/machinery/atmospherics/miner/template = options.gas_options[selection]
		var/obj/machinery/atmospherics/miner/constructible/miner = allocate(board.build_path, location, board)
		TEST_ASSERT_EQUAL(miner.circuit, board, "Construction must retain the configured board.")
		TEST_ASSERT_EQUAL(miner.spawn_id, initial(template.spawn_id), "The constructed miner must produce the selected gas.")
		TEST_ASSERT(!miner.active, "A newly constructed miner must start switched off.")
		TEST_ASSERT(!(miner.resistance_flags & INDESTRUCTIBLE), "Constructed miners must be destructible.")
		location.copy_air(empty_air)
		miner.mine_gas(1)
		var/datum/gas_mixture/output = location.return_air()
		TEST_ASSERT_EQUAL(output.moles[miner.spawn_id], miner.spawn_mol, "The miner must release the configured gas into its room.")
		miner.deconstruct(TRUE)
		TEST_ASSERT(!QDELETED(board), "Disassembly must preserve the board.")
		TEST_ASSERT_EQUAL(board.loc, location, "Disassembly must return the board.")
		TEST_ASSERT_EQUAL(board.gas_selection, selection, "Disassembly must preserve the selected gas.")
	restore_atmos()
